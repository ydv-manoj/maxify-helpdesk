# Which provider the agent uses: anthropic | openai | gemini | mock
LLM_PROVIDER=mock
# Optional model override (defaults per provider are in app/llm/factory.py)
LLM_MODEL=
# Keys: fill only the one you use. Never commit .env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional pricing (USD per 1M tokens) so cost is recorded per call
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=
JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
LIVE_LLM_PROVIDER=gemini
LIVE_LLM_MODEL=gemini-3.5-flash-lite
DECIDER_PROVIDER=jev
JEV_MODEL=jev-latest
JEV_API_KEY=
